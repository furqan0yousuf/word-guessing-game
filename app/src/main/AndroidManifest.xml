<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="Word Guessing Game"
        android:supportsRtl="true"
        android:theme="@style/Theme.WordGuessingGame">

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".PlayerSetupActivity"
            android:exported="false" />

        <activity
            android:name=".GameSetupActivity"
            android:exported="false" />

        <activity
            android:name=".GameActivity"
            android:exported="false" />

        <!-- Online Game screens -->

        <activity
            android:name=".OnlineGameActivity"
            android:exported="false" />

        <activity
            android:name=".CreateGameActivity"
            android:exported="false" />

        <activity
            android:name=".JoinGameActivity"
            android:exported="false" />

        <activity
            android:name=".GameWaitingActivity"
            android:exported="false" />

        <activity
            android:name=".OnlineGameRoundActivity"
            android:exported="false" />

    </application>

</manifest>
